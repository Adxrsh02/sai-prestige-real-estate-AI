# =============================================================================
# SAI PRESTIGE — OFFICIAL ENVIRONMENT CONFIGURATION & INTEGRATIONS TEMPLATE
# =============================================================================
# IMPORTANT:
# - Copy this file to .env.local for local development.
# - NEVER commit .env.local to Git. All real secrets must be set as environment
#   variables in your Cloudflare dashboard (Settings > Variables and Secrets).
# =============================================================================

# Production Domain Reference (Informational)
# Canonical Base URL: https://saiprestigerealestate.com

# -----------------------------------------------------------------------------
# 1. Resend Email Delivery (Server-Side Only)
# -----------------------------------------------------------------------------
# Do NOT prefix with NEXT_PUBLIC_ to prevent leaking the secret API key to browser bundles.
# Obtain your production API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_real_resend_api_key_here

# Official Verified Sender Identity on saiprestigerealestate.com
# Resend requires domain DNS verification before sending from this address.
RESEND_FROM_EMAIL=Sai Prestige <contact@saiprestigerealestate.com>

# Dedicated Business Notification Recipient (Admin Inbox)
CONTACT_TO_EMAIL=sai.prestige01@gmail.com

# -----------------------------------------------------------------------------
# 2. Cloudflare Turnstile Bot Protection
# -----------------------------------------------------------------------------
# Server-side secret key used to verify tokens via https://challenges.cloudflare.com/turnstile/v0/siteverify
# Production: Obtain from Cloudflare Dashboard > Turnstile > Settings > Secret Key
# Testing key (always passes): 1x0000000000000000000000000000000AA
# Testing key (always blocks): 2x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Public site key used to initialize the Turnstile widget in the client browser
# Production: Obtain from Cloudflare Dashboard > Turnstile > Site Key
# Testing site key (always passes): 1x00000000000000000000AA
# Testing site key (always blocks): 2x00000000000000000000AB
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# -----------------------------------------------------------------------------
# 3. Google Analytics 4 (Client-Side, Optional)
# -----------------------------------------------------------------------------
# Measurement ID from Google Analytics (Data Streams > Web Stream Details).
# Format: G-XXXXXXXXXX
# Leave empty if not configured; tracking will be automatically and safely disabled.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# -----------------------------------------------------------------------------
# 4. Google Maps Embed API Key (Client-Side, Optional)
# -----------------------------------------------------------------------------
# Optional API key for Google Maps Embed API v1.
# If omitted, the website automatically uses privacy-preserving query embed fallback.
# Restrict this key in Google Cloud Console to:
# - https://saiprestigerealestate.com/*
# - https://www.saiprestigerealestate.com/*
# - http://localhost:3000/*
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
